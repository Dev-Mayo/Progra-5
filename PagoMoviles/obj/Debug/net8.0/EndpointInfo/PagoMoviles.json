{
  "openapi": "3.0.1",
  "info": {
    "title": "Pagos Móviles API",
    "description": "API de Pagos Móviles - SRV9, SRV10, SRV19",
    "version": "v1"
  },
  "paths": {
    "/auth/register": {
      "post": {
        "tags": [
          "AuthPagoMovil"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PagoMovilRegistroDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/PagoMovilRegistroDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/PagoMovilRegistroDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/auth/cancel-subscription": {
      "post": {
        "tags": [
          "AuthPagoMovil"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PagoMovilRegistroDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/PagoMovilRegistroDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/PagoMovilRegistroDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/core/client-exists": {
      "post": {
        "tags": [
          "CoreCliente"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClienteExistsDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ClienteExistsDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ClienteExistsDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ClienteExistsDto": {
        "type": "object",
        "properties": {
          "identificacion": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PagoMovilRegistroDto": {
        "type": "object",
        "properties": {
          "numeroCuenta": {
            "type": "string",
            "nullable": true
          },
          "identificacion": {
            "type": "string",
            "nullable": true
          },
          "numeroTelefono": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "apiKey",
        "description": "Escribí: Bearer token123",
        "name": "Authorization",
        "in": "header"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ]
}