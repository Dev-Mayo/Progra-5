{
  "openapi": "3.0.4",
  "info": {
    "title": "CoreBancarioAPI",
    "version": "1.0"
  },
  "paths": {
    "/core/accounts": {
      "post": {
        "tags": [
          "SA11"
        ],
        "operationId": "CrearCuenta",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CuentaRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/core/transaction": {
      "post": {
        "tags": [
          "SRV14"
        ],
        "operationId": "AplicarTransaccion",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransactionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/core/balance": {
      "get": {
        "tags": [
          "SRV15"
        ],
        "operationId": "ConsultarSaldo",
        "parameters": [
          {
            "name": "identificacion",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "numeroCuenta",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/core/transactions": {
      "get": {
        "tags": [
          "SRV16"
        ],
        "operationId": "ConsultarUltimosMovimientos",
        "parameters": [
          {
            "name": "identificacion",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "numeroCuenta",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CuentaRequest": {
        "type": "object",
        "properties": {
          "clienteId": {
            "type": "integer",
            "format": "int32"
          },
          "tipoCuenta": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "TransactionRequest": {
        "type": "object",
        "properties": {
          "numeroCuenta": {
            "type": "string",
            "nullable": true
          },
          "tipoMovimiento": {
            "type": "string",
            "nullable": true
          },
          "monto": {
            "type": "number",
            "format": "double"
          },
          "descripcion": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}