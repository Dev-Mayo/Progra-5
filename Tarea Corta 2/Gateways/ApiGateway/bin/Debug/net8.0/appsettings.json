{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "ruta-productos": {
        "ClusterId": "cluster-productos",
        "Match": {
          "Path": "/api/productos/{**remainder}"
        }
      },
      "ruta-ordenes": {
        "ClusterId": "cluster-ordenes",
        "Match": {
          "Path": "/api/pedidos/{**remainder}"
        }
      },
      "ruta-clientes": {
        "ClusterId": "cluster-clientes",
        "Match": {
          "Path": "/api/clientes/{**remainder}"
        }
      }
    },
    "Clusters": {
      "cluster-productos": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7273/"
          }                                                                               
        }
      },
      "cluster-ordenes": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7165/"
          }
        }
      },
      "cluster-clientes": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7248/"
          }
        },
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        }
      }
    }
  },
  "AllowedHosts": "*"
}